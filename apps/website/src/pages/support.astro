---
/*
 * The support page, with the copy of the first site in the layout of the privacy policies: the
 * header, then numbered sections with a list of them beside it on wide screens. It sits on the
 * night ground and closes on the Turin skyline.
 */
import SiteSkyline from '../components/SiteSkyline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const sections = [
  { slug: 'contact', text: 'Contact' },
  { slug: 'sticko', text: 'Sticko' },
];
---

<BaseLayout title="Support" description="How to get help with North Foundry software, including Sticko.">
  <article aria-labelledby="support-title">
    <div class="mx-auto w-full max-w-360 px-5 pt-16 pb-20 md:px-10 md:pt-24 md:pb-28 xl:px-16">
      <header>
        <p class="label">Support</p>
        <h1 id="support-title" class="serif mt-4 max-w-[16ch] text-display leading-tight font-[480] tracking-[-0.035em]">
          How can we help?
        </h1>
        <p class="mt-6 max-w-[40ch] text-lede text-muted-foreground">
          A question, a problem, or an idea about our software? Write to us. A person reads every message.
        </p>
      </header>

      <div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-10 border-t border-rule pt-12 md:mt-24 md:grid-cols-12">
        <aside class="hidden md:col-span-3 md:block">
          <nav aria-label="Sections of this page" class="md:sticky md:top-24">
            <p class="label">On this page</p>
            <ol class="mt-3 flex flex-col gap-2">
              {
                sections.map((section, index) => (
                  <li>
                    <a
                      href={`#${section.slug}`}
                      class="flex gap-3 text-caption text-muted-foreground transition-colors hover:text-foreground"
                    >
                      <span class="mono text-signal">{String(index + 1).padStart(2, '0')}</span>
                      {section.text}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>

        <div class="support md:col-span-7 md:col-start-5">
          <h2 id="contact">Contact</h2>
          <p>
            Email <a href="mailto:hello@northfoundry.eu">hello@northfoundry.eu</a>. Tell us which app you use, which
            version, and what you expected to happen.
          </p>
          <p>
            For open-source projects you can also open an issue in the project’s repository
            on <a href={site.github} rel="noreferrer">GitHub</a>.
          </p>

          <h2 id="sticko">Sticko</h2>
          <p>
            <strong>Why does Sticko ask for Reminders or Calendar access?</strong> To draw your reminders and events on
            a board. Sticko reads them on your iPhone only. You can change this
            in <strong>Settings › Privacy &amp; Security</strong>.
          </p>
          <p>
            <strong>How do I put a board on my lock screen?</strong> In the board, tap <em>Save to Photos</em>. Then
            open the image in Photos, tap the share button and choose <em>Use as Wallpaper</em>.
          </p>
          <p>
            <strong>Does Sticko collect my data?</strong> No. Read
            the <a href="/privacy/sticko/">Sticko privacy policy</a>.
          </p>
        </div>
      </div>
    </div>
  </article>

  <SiteSkyline />
</BaseLayout>

<style>
  @reference '../styles/app.css';

  /* The body: numbered sections, set like the privacy policies. */
  .support {
    counter-reset: section;
  }

  .support h2 {
    counter-increment: section;
    @apply mt-14 border-t border-rule pt-5 text-title font-medium tracking-snug;
  }

  /*
   * The privacy policies open on a paragraph before the first section; here the first section
   * opens the column, so it sits on the full-width rule above instead of drawing a second one.
   */
  .support h2:first-child {
    @apply mt-0 border-t-0 pt-0;
  }

  .support h2::before {
    content: counter(section, decimal-leading-zero);
    @apply mb-2 block mono text-caption text-signal;
  }

  .support p {
    @apply mt-4 max-w-measure text-muted-foreground;
  }

  .support strong {
    @apply font-medium text-foreground;
  }

  .support a {
    @apply text-link underline decoration-link-decoration underline-offset-4 transition-colors hover:decoration-signal;
  }
</style>
