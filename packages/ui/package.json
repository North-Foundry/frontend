    },
    "./button": {
      "types": "./src/components/button/index.ts",
      "default": "./src/components/button/index.ts"
    },
    "./checkbox": {
      "types": "./src/components/checkbox/index.ts",
      "default": "./src/components/checkbox/index.ts"
    },
    "./radio-group": {
      "types": "./src/components/radio-group/index.ts",
      "default": "./src/components/radio-group/index.ts"
    },
    "./select": {
      "types": "./src/components/select/index.ts",
      "default": "./src/components/select/index.ts"
    },
