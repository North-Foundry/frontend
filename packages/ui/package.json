{
  "name": "@north-foundry/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./north-arrow": {
      "types": "./src/components/north-arrow/index.ts",
      "default": "./src/components/north-arrow/index.ts"
    },
    "./dither-underlay": {
      "types": "./src/components/dither-underlay/index.ts",
      "default": "./src/components/dither-underlay/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
